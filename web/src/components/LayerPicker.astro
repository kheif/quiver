---
// The hero's live panel: pick a team and a folder, see what the assistant gets.
import demo from '../data/demo.json';
import { served, where } from '../scripts/session';

const rows = served('ui', 'checkout-web');
const on = rows.filter((r) => r.always).length;
const folders = [
	['checkout-web', 'checkout-web'],
	['api', 'api'],
	['none', '~/notes'],
];
---

<div class="ui" data-ui role="group" aria-labelledby="picker-title">
	<div class="uihead">
		<h2 id="picker-title">What the assistant gets here</h2>
		<span id="picker-where">{where('checkout-web')}</span>
	</div>
	<div class="picker">
		<div class="group">
			<span class="label" id="team-label">Team</span>
			<div class="seg" role="group" aria-labelledby="team-label">
				{
					Object.entries(demo.teams).map(([id, t], i) => (
						<button type="button" data-team={id} aria-pressed={i === 0 ? 'true' : 'false'}>
							{t.name.replace(' team', '')}
						</button>
					))
				}
			</div>
		</div>
		<div class="group">
			<span class="label" id="folder-label">Folder</span>
			<div class="seg" role="group" aria-labelledby="folder-label">
				{
					folders.map(([id, name], i) => (
						<button type="button" data-folder={id} aria-pressed={i === 0 ? 'true' : 'false'}>
							{name}
						</button>
					))
				}
			</div>
		</div>
	</div>
	<p class="legend"><span class="on" aria-hidden="true"></span>always on: in the conversation before your first message</p>
	<p class="sum" id="served-sum">
		<b>{on} always on</b>, loaded at session start. <b>{rows.length - on} more</b> when a task needs
		them. Company and team layers come with Quiver for teams.
	</p>
	<ul class="served" id="served">
		{
			rows.map((r) => (
				<li>
					<span class={r.always ? 'on' : ''} aria-hidden="true" />
					<span class="id">{r.always && <span class="sr">always on: </span>}{r.id}</span>
					<span class="layer">{r.layer}</span>
				</li>
			))
		}
	</ul>
	<p class="sr" id="picker-status" aria-live="polite"></p>

</div>

<script>
	import { served, where, type Folder, type Team } from '../scripts/session';

	const state: { team: Team; folder: Folder } = { team: 'ui', folder: 'checkout-web' };
	const list = document.getElementById('served');
	const sum = document.getElementById('served-sum');
	const place = document.getElementById('picker-where');

	function render() {
		const rows = served(state.team, state.folder);
		if (list) {
			list.replaceChildren(
				...rows.map((r, i) => {
					const li = document.createElement('li');
					li.className = 'enter';
					li.style.animationDelay = `${i * 35}ms`;
					const dot = document.createElement('span');
					dot.setAttribute('aria-hidden', 'true');
					if (r.always) dot.className = 'on';
					const id = document.createElement('span');
					id.className = 'id';
					if (r.always) {
						const hint = document.createElement('span');
						hint.className = 'sr';
						hint.textContent = 'always on: ';
						id.append(hint);
					}
					id.append(r.id);
					const layer = document.createElement('span');
					layer.className = 'layer';
					layer.textContent = r.layer;
					li.append(dot, id, layer);
					return li;
				}),
			);
		}
		const on = rows.filter((r) => r.always).length;
		if (sum) {
			sum.innerHTML = `<b>${on} always on</b>, loaded at session start. <b>${rows.length - on} more</b> when a task needs them. Company and team layers come with Quiver for teams.`;
		}
		if (place) place.textContent = where(state.folder);
	}

	/** One short line for screen readers after a pick; the list itself is not live. */
	function announce() {
		const rows = served(state.team, state.folder);
		const on = rows.filter((r) => r.always).length;
		const status = document.getElementById('picker-status');
		if (status) status.textContent = `${where(state.folder)}: ${on} always on, ${rows.length - on} when a task needs them.`;
	}

	document.querySelectorAll<HTMLButtonElement>('.ui [data-team], .ui [data-folder]').forEach((button) =>
		button.addEventListener('click', () => {
			if (button.dataset.team) state.team = button.dataset.team as Team;
			if (button.dataset.folder) state.folder = button.dataset.folder as Folder;
			button.parentElement
				?.querySelectorAll('button')
				.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
			render();
			announce();
		}),
	);
</script>

<style>
	.ui {
		width: min(620px, 100%);
		padding: 22px 22px 24px;
		background: var(--q-bg);
		color: var(--q-text);
	}

	.uihead {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 12px;
	}

	.uihead h2 {
		font-size: var(--q-step-lead);
		letter-spacing: -0.02em;
	}

	.uihead span,
	.label,
	.legend,
	.served :global(.layer),
	.sum {
		color: var(--q-text-2);
		font-size: var(--q-step-small);
	}

	.picker {
		display: flex;
		flex-wrap: wrap;
		gap: 18px;
		margin: 14px 0 4px;
	}

	.group {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
	}

	/* Labels stay on one line; on a narrow phone the buttons wrap instead. */
	.seg {
		display: inline-flex;
		flex-wrap: wrap;
		padding: 3px;
		background: var(--q-surface);
	}

	.seg button {
		padding: 9px 12px;
		border: 0;
		background: transparent;
		color: var(--q-text);
		font: 500 14px / 1 var(--q-font-sans);
		white-space: nowrap;
		cursor: pointer;
	}

	@media (pointer: coarse) {
		.seg button {
			min-height: 44px;
		}
	}

	.seg button[aria-pressed='true'] {
		background: var(--q-text);
		color: var(--q-bg);
	}

	.seg button:hover:not([aria-pressed='true']) {
		background: var(--q-surface-2);
	}

	.legend {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-top: 10px;
	}

	/* Room for the longest list (seven rows), so picking never moves the page. */
	.served {
		min-height: calc(7 * 36px);
		margin: 10px 0 0;
		padding: 0;
		list-style: none;
		font-size: 15px;
	}

	.served :global(li) {
		display: grid;
		grid-template-columns: 18px 1fr auto;
		align-items: center;
		gap: 10px;
		min-height: 36px;
		padding: 4px 0;
		border-bottom: 2px solid var(--q-surface);
	}

	.served :global(li:last-child) {
		border-bottom: 0;
	}

	.ui :global(.on) {
		display: inline-block;
		width: 12px;
		height: 12px;
		background: var(--q-accent);
		clip-path: polygon(0 50%, 50% 50%, 50% 0, 100% 0, 100% 100%, 0 100%);
	}

	.served :global(.id) {
		font-weight: 500;
	}

	.served :global(li.enter) {
		animation: rowin 0.28s var(--q-ease) both;
	}

	@keyframes rowin {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
	}

	.sum {
		margin-top: 8px;
	}

	.sum :global(b) {
		color: var(--q-text);
		font-weight: 500;
	}

	@media (prefers-reduced-motion: reduce) {
		.served :global(li.enter) {
			animation: none;
		}
	}

	@media (max-width: 760px) {
		.ui {
			padding: 18px;
		}

		.picker {
			gap: 10px;
		}
	}
</style>
